APP_NAME="Pendataan Guru BIMAS Katolik"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://data.bimkattts.org
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
